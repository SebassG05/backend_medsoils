# Server Configuration
PORT=5116
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/medsoils

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
JWT_EXPIRE=1h

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/callback

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Frontend URL for CORS (production: https://frontend-medsoils.vercel.app)
FRONTEND_URL=http://localhost:3017
